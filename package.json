{
  "name": "evren-codex-bridge",
  "version": "1.1.0",
  "private": true,
  "description": "Local compatibility bridge between OpenAI Codex CLI and the EVREN Responses API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:evren": "tsx scripts/smoke-evren.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fastify": "^5.6.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
